# EmailJS (https://www.emailjs.com) — public values, safe in the client bundle.
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# "file" renders an Upload CV field (attachments need an EmailJS paid plan);
# "link" swaps it for a "Link to your CV" URL field.
VITE_CV_UPLOAD_MODE=file
